@page "/clientes/nuevo"
@page "/clientes/{Id:int}/editar"
@inject ClienteService ClienteSvc
@inject NavigationManager Nav

<PageTitle>@(_isEdit ? "Editar cliente" : "Nuevo cliente") — Mecánico</PageTitle>

<div class="d-flex align-items-center mb-3">
    <a href="/clientes" class="btn btn-sm btn-outline-secondary me-2">← Volver</a>
    <h2 class="mb-0">@(_isEdit ? "✏️ Editar cliente" : "👤 Nuevo cliente")</h2>
</div>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="card shadow-sm" style="max-width:600px">
        <div class="card-body">
            <EditForm Model="_form" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                @if (_errorMsg is not null)
                {
                    <div class="alert alert-danger">@_errorMsg</div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre *</label>
                        <InputText class="form-control" @bind-Value="_form.Nombre" />
                        <ValidationMessage For="() => _form.Nombre" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellido *</label>
                        <InputText class="form-control" @bind-Value="_form.Apellido" />
                        <ValidationMessage For="() => _form.Apellido" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email *</label>
                        <InputText class="form-control" type="email" @bind-Value="_form.Email" />
                        <ValidationMessage For="() => _form.Email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="_form.Telefono" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Dirección</label>
                        <InputText class="form-control" @bind-Value="_form.Direccion" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(_isEdit ? "Guardar cambios" : "Crear cliente")
                    </button>
                    <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private ClienteForm _form = new();
    private bool _isEdit => Id.HasValue;
    private bool _loading = true;
    private bool _saving = false;
    private string? _errorMsg;

    protected override async Task OnParametersSetAsync()
    {
        if (_isEdit)
        {
            var cliente = await ClienteSvc.GetByIdAsync(Id!.Value);
            if (cliente is null) { Nav.NavigateTo("/clientes"); return; }
            _form = new ClienteForm
            {
                Nombre = cliente.Nombre,
                Apellido = cliente.Apellido,
                Email = cliente.Email,
                Telefono = cliente.Telefono,
                Direccion = cliente.Direccion
            };
        }
        _loading = false;
    }

    private async Task Guardar()
    {
        _saving = true;
        _errorMsg = null;

        if (_isEdit)
        {
            var (_, error) = await ClienteSvc.UpdateAsync(Id!.Value, _form);
            if (error is not null) { _errorMsg = error; _saving = false; return; }
        }
        else
        {
            var (_, error) = await ClienteSvc.CreateAsync(_form);
            if (error is not null) { _errorMsg = error; _saving = false; return; }
        }

        Nav.NavigateTo("/clientes");
    }
}
